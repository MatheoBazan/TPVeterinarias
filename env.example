# Copiar este archivo a .env (que NO se versiona) y reemplazar <usuario> y <clave>
# en las tres lineas que los usan. Mantener el mismo puerto en POSTGRES_PORT y en
# las dos URLs. Si la clave tiene caracteres especiales (@ : / #), codificarla en URL.

# Lo lee Docker Compose (docker-compose.yml)
POSTGRES_USER=<usuario>
POSTGRES_PASSWORD=<clave>
POSTGRES_DB=veterinaria
POSTGRES_PORT=5433

# Lo lee la aplicacion (desarrollo) y la suite pytest (base veterinaria_test)
DATABASE_URL=postgresql+asyncpg://<usuario>:<clave>@localhost:5433/veterinaria
TEST_DATABASE_URL=postgresql+asyncpg://<usuario>:<clave>@localhost:5433/veterinaria_test

# 1 o true: imprime en consola cada sentencia SQL (evidencia del caso C-07). Apagado por defecto.
SQL_ECHO=0
